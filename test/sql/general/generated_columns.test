# name: test/sql/general/generated_columns.test
# description: Test generated columns in ducklake
# group: [general]

require ducklake

require parquet

# Use BASE_TEST_NAME (stable) — {UUID} is regenerated on every path expansion and breaks detach/reattach
test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_generated_files')

# Constant generated columns are materialized as defaults
statement ok
CREATE TABLE ducklake.t0(c0 INT AS (1), c1 INT);

statement ok
INSERT INTO ducklake.t0(c1) VALUES (10);

query II
SELECT * FROM ducklake.t0
----
1	10

# Column-ref generated columns are evaluated on insert
statement ok
CREATE TABLE ducklake.t1(c1 INT, c2 INT AS (c1 + 1));

statement ok
INSERT INTO ducklake.t1(c1) VALUES (10), (20);

query II
SELECT * FROM ducklake.t1 ORDER BY c1
----
10	11
20	21

# Survives detach + reattach
statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_generated_files')

query II
SELECT * FROM ducklake.t1 ORDER BY c1
----
10	11
20	21

# Cannot update generated column directly
statement error
UPDATE ducklake.t1 SET c2 = 0;
----
generated

# Updating a base column recomputes the generated column
statement ok
UPDATE ducklake.t1 SET c1 = 100 WHERE c1 = 10;

query II
SELECT * FROM ducklake.t1 ORDER BY c1
----
20	21
100	101

# INSERT providing all columns still overwrites generated (GENERATED ALWAYS)
statement ok
INSERT INTO ducklake.t1 VALUES (30, 999);

query I
SELECT c2 FROM ducklake.t1 WHERE c1 = 30
----
31

# Reject references to other generated columns
statement error
CREATE TABLE ducklake.bad(a INT AS (1), b INT AS (a + 1));
----
generated
