# name: test/sql/types/enum.test
# description: test ENUM types in ducklake
# group: [types]

require ducklake

require parquet

# Use BASE_TEST_NAME (stable) — {UUID} is regenerated on every path expansion and breaks detach/reattach
test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_enum_files')

statement ok
CREATE TABLE ducklake.test AS SELECT 'hello'::ENUM('world', 'hello') AS h;

statement ok
INSERT INTO ducklake.test VALUES ('world');

query I
SELECT * FROM ducklake.test ORDER BY h
----
world
hello

query I
SELECT typeof(h) FROM ducklake.test LIMIT 1
----
ENUM('world', 'hello')

# Persisted CREATE TYPE (ENUM)
statement ok
CREATE TYPE ducklake.mood AS ENUM ('happy', 'sad');

statement ok
CREATE TABLE ducklake.moods(m ducklake.mood);

statement ok
INSERT INTO ducklake.moods VALUES ('happy'), ('sad');

query I
SELECT * FROM ducklake.moods ORDER BY m
----
happy
sad

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_enum_files')

query I
SELECT * FROM ducklake.test ORDER BY h
----
world
hello

query I
SELECT typeof(h) FROM ducklake.test LIMIT 1
----
ENUM('world', 'hello')

# Column ENUM physical type and named CREATE TYPE both persist across detach
query I
SELECT * FROM ducklake.moods ORDER BY m
----
happy
sad

query I
SELECT 'happy'::ducklake.mood;
----
happy

# Persisted CREATE TYPE (STRUCT)
statement ok
CREATE TYPE ducklake.point AS STRUCT(x INT, y INT);

statement ok
CREATE TABLE ducklake.pts(p ducklake.point);

statement ok
INSERT INTO ducklake.pts VALUES ({'x': 1, 'y': 2});

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_enum_files')

query II
SELECT p.x, p.y FROM ducklake.pts;
----
1	2

query I
SELECT typeof(p) FROM ducklake.pts;
----
STRUCT(x INTEGER, y INTEGER)

# DROP TYPE removes the named type across reattach
statement ok
DROP TYPE ducklake.mood;

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_enum_files')

statement error
SELECT 'happy'::ducklake.mood;
----

# Column data using the physical ENUM still works after DROP TYPE
query I
SELECT * FROM ducklake.moods ORDER BY m
----
happy
sad
