# name: test/sql/types/array.test
# description: test ARRAY types in ducklake
# group: [types]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_array.db' AS ducklake (DATA_PATH '{TEST_DIR}/ducklake_array_files')

statement ok
CREATE TABLE ducklake.test(a INTEGER[3]);

statement ok
INSERT INTO ducklake.test VALUES ([1, 2, 3]), ([4, 5, 6]);

query I
SELECT * FROM ducklake.test ORDER BY a[1]
----
[1, 2, 3]
[4, 5, 6]

query I
SELECT typeof(a) FROM ducklake.test LIMIT 1
----
INTEGER[3]

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_array.db' AS ducklake (DATA_PATH '{TEST_DIR}/ducklake_array_files')

query I
SELECT * FROM ducklake.test ORDER BY a[1]
----
[1, 2, 3]
[4, 5, 6]

query I
SELECT typeof(a) FROM ducklake.test LIMIT 1
----
INTEGER[3]
