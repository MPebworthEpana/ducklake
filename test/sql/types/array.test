# name: test/sql/types/array.test
# description: test ARRAY types in ducklake
# group: [types]

require ducklake

require parquet

# Use BASE_TEST_NAME (stable) — {UUID} is regenerated on every path expansion and breaks detach/reattach
test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_array_files')

statement ok
CREATE TABLE ducklake.test(a INTEGER[3]);

statement ok
INSERT INTO ducklake.test VALUES ([1, 2, 3]), ([4, 5, 6]);

query I
SELECT * FROM ducklake.test ORDER BY a[1]
----
[1, 2, 3]
[4, 5, 6]

query I
SELECT typeof(a) FROM ducklake.test LIMIT 1
----
INTEGER[3]

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_array_files')

query I
SELECT * FROM ducklake.test ORDER BY a[1]
----
[1, 2, 3]
[4, 5, 6]

query I
SELECT typeof(a) FROM ducklake.test LIMIT 1
----
INTEGER[3]
