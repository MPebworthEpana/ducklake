# name: test/sql/branching/writable_branch_inlining.test
# description: H3 G4 — shared-table inlining enabled on non-main branches with isolation
# group: [branching]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# Default inlining enabled — branch inserts must still not leak to main
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_branch_inline')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1);

statement ok
CALL ducklake_create_branch('ducklake', 'dev')

statement ok
CALL ducklake.use_branch('dev')

statement ok
INSERT INTO ducklake.t VALUES (100);

query I
SELECT * FROM ducklake.t ORDER BY i
----
1
100

statement ok con1
CALL ducklake.use_branch('main')

query I con1
SELECT * FROM ducklake.t ORDER BY i
----
1

query II
SELECT COUNT(DISTINCT table_name), COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_inlined_data_tables
----
1	1

query I
SELECT COUNT(DISTINCT branch_id) FROM __ducklake_metadata_ducklake.ducklake_inlined_data_1_1
----
2

statement ok con1
INSERT INTO ducklake.t VALUES (2);

query I con1
SELECT * FROM ducklake.t ORDER BY i
----
1
2

query II
SELECT COUNT(DISTINCT table_name), COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_inlined_data_tables
----
1	1

# Branch must not see main's post-fork insert
statement ok
CALL ducklake.use_branch('dev')

query I
SELECT * FROM ducklake.t ORDER BY i
----
1
100

# Branch-local inlined rows remain after another branch-local insert
statement ok
INSERT INTO ducklake.t VALUES (101);

query I
SELECT * FROM ducklake.t ORDER BY i
----
1
100
101

query I con1
SELECT * FROM ducklake.t ORDER BY i
----
1
2
