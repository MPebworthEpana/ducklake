# name: test/sql/branching/branch_gc_and_history.test
# description: Phase 3 — branch-aware expiry pins, drop reclamation, per-branch snapshots
# group: [branching]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_branch_gc')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1);

statement ok
CALL ducklake.create_branch('dev')

statement ok
CALL ducklake.use_branch('dev')

statement ok
INSERT INTO ducklake.t VALUES (2);

# Per-branch history includes fork-capped ancestors + own commits
query I
SELECT count(*) >= 2 FROM ducklake.snapshots(branch := 'dev')
----
true

query I
SELECT count(*) >= 1 FROM ducklake.snapshots(branch := 'main')
----
true

# Expiry with multiple branches is allowed (no P2 refuse)
statement ok
CALL ducklake.use_branch('main')

statement ok
FROM ducklake_expire_snapshots('ducklake', older_than := TIMESTAMPTZ '1900-01-01', dry_run := true)
# Unmerged branch drop reclaims owned snapshots
statement ok
CALL ducklake.drop_branch('dev')

query I
SELECT count(*) FROM ducklake.refs() WHERE ref_name = 'dev'
----
0
