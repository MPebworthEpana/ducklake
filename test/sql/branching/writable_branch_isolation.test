# name: test/sql/branching/writable_branch_basic.test
# description: Phase 2 M2 — branch-owned objects are invisible on main / siblings
# group: [branching]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_branch_iso')

statement ok
CREATE TABLE ducklake.base(i INTEGER);

statement ok
INSERT INTO ducklake.base VALUES (1);

statement ok
CALL ducklake_create_branch('ducklake', 'dev')

statement ok
CALL ducklake.use_branch('dev')

statement ok
CREATE TABLE ducklake.only_on_dev(s VARCHAR);

statement ok
INSERT INTO ducklake.only_on_dev VALUES ('hello');

query I
SELECT * FROM ducklake.only_on_dev
----
hello

# Main must not see the branch-only table (lineage isolation)
statement ok con1
CALL ducklake.use_branch('main')

statement error con1
SELECT * FROM ducklake.only_on_dev
----
only_on_dev

query I con1
SELECT * FROM ducklake.base ORDER BY i
----
1

# Main can still advance independently
statement ok con1
INSERT INTO ducklake.base VALUES (2);

query I con1
SELECT * FROM ducklake.base ORDER BY i
----
1
2

# Branch still sees inherited base (fork-point cap) plus its own table
statement ok
CALL ducklake.use_branch('dev')

query I
SELECT * FROM ducklake.base ORDER BY i
----
1

query I
SELECT * FROM ducklake.only_on_dev
----
hello
