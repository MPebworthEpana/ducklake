# name: test/sql/branching/transplant.test
# description: Phase 5 T2 — contiguous-range transplant
# group: [branching]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_transplant', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1);

statement ok
CALL ducklake.create_branch('dev')

statement ok
CALL ducklake.use_branch('dev')

statement ok
INSERT INTO ducklake.t VALUES (2);

statement ok
DELETE FROM ducklake.t WHERE i = 2;

statement ok
INSERT INTO ducklake.t VALUES (3);

# dry_run validates the whole range and does not advance main
statement ok
CREATE TEMP TABLE main_head_before AS
SELECT snapshot_id FROM ducklake.refs() WHERE ref_name = 'main';

query I
SELECT DISTINCT transplant_type
FROM ducklake.transplant('dev', 3::UBIGINT, 5::UBIGINT, target := 'main', dry_run := true)
----
transplant

query I
SELECT CASE WHEN (SELECT snapshot_id FROM ducklake.refs() WHERE ref_name = 'main') =
                 (SELECT snapshot_id FROM main_head_before)
            THEN 1 ELSE 0 END
----
1

# Apply all three source-owned snapshots as a validated unit. The delete in
# snapshot 4 depends on the file inserted by snapshot 3.
query II
SELECT DISTINCT transplant_type, snapshots_applied
FROM ducklake.transplant('dev', 3::UBIGINT, 5::UBIGINT, target := 'main')
----
transplant	3

statement ok
CALL ducklake.use_branch('main')

query I
SELECT i FROM ducklake.t ORDER BY i
----
1
3

query I
SELECT CASE WHEN commit_extra_info LIKE '%transplant_source=dev%' AND
                 commit_extra_info LIKE '%transplant_start=3%' AND
                 commit_extra_info LIKE '%transplant_end=5%' AND
                 commit_extra_info LIKE '%transplant_snapshot=5%'
            THEN 1 ELSE 0 END
FROM ducklake.snapshots()
WHERE snapshot_id = (SELECT snapshot_id FROM ducklake.refs() WHERE ref_name = 'main')
----
1

# Range endpoints must be source-owned snapshots.
statement error
SELECT * FROM ducklake.transplant('dev', 2::UBIGINT, 5::UBIGINT, target := 'main', dry_run := true)
----
Transplant range endpoints

# Source DML conflicts with target-side schema evolution.
statement ok
CALL ducklake.create_branch('conflict_dev')

statement ok
CALL ducklake.use_branch('conflict_dev')

statement ok
INSERT INTO ducklake.t(i) VALUES (9);

statement ok
CALL ducklake.use_branch('main')

statement ok
ALTER TABLE ducklake.t ADD COLUMN j INTEGER;

query I
SELECT DISTINCT transplant_type
FROM ducklake.transplant('conflict_dev', 9::UBIGINT, 9::UBIGINT, target := 'main', dry_run := true)
----
conflicts

statement error
SELECT * FROM ducklake.transplant('conflict_dev', 9::UBIGINT, 9::UBIGINT, target := 'main')
----
Transplant conflict
