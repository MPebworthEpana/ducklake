# name: test/sql/branching/cherry_pick_ddl.test
# description: F1.2 — cherry-pick / transplant compose-clean DDL
# group: [branching]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_cherry_pick_ddl', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.base(i INTEGER);

statement ok
INSERT INTO ducklake.base VALUES (1);

statement ok
CREATE TABLE ducklake.drop_base(a INTEGER, b VARCHAR);

statement ok
CALL ducklake.create_branch('dev')

statement ok
CALL ducklake.use_branch('dev')

# Source snapshots 4..12 are compose-clean DDL on dev.
statement ok
CREATE SCHEMA ducklake.s;

statement ok
CREATE TABLE ducklake.s.t(a INTEGER);

statement ok
CREATE VIEW ducklake.s.v AS SELECT a FROM ducklake.s.t;

statement ok
CREATE MACRO ducklake.plus_one(x) AS x + 1;

statement ok
CREATE MACRO ducklake.table_one(n) AS TABLE SELECT n AS v;

statement ok
ALTER TABLE ducklake.s.t ADD COLUMN b VARCHAR;

statement ok
ALTER TABLE ducklake.drop_base DROP COLUMN b;

statement ok
CREATE VIEW ducklake.s.vdrop AS SELECT 42 AS x;

statement ok
DROP VIEW ducklake.s.vdrop;

statement ok
CALL ducklake.use_branch('main')

# CREATE SCHEMA
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 4::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT count(*) FROM information_schema.schemata
WHERE catalog_name = 'ducklake' AND schema_name = 's'
----
1

# CREATE TABLE in the picked schema
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 5::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT count(*) FROM ducklake.s.t
----
0

# CREATE VIEW
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 6::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT count(*) FROM ducklake.s.v
----
0

# CREATE scalar macro
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 7::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT ducklake.plus_one(4)
----
5

# CREATE table macro
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 8::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT v FROM ducklake.table_one(9)
----
9

# ALTER TABLE ADD COLUMN
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 9::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT count(*) FROM duckdb_columns()
WHERE database_name = 'ducklake' AND schema_name = 's' AND table_name = 't' AND column_name = 'b'
----
1

# ALTER TABLE DROP COLUMN
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 10::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT count(*) FROM duckdb_columns()
WHERE database_name = 'ducklake' AND schema_name = 'main' AND table_name = 'drop_base' AND column_name = 'b'
----
0

# DROP VIEW: first pick the create, then the drop.
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 11::UBIGINT, target := 'main')
----
cherry_pick

query I
SELECT x FROM ducklake.s.vdrop
----
42

query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('dev', 12::UBIGINT, target := 'main')
----
cherry_pick

statement error
SELECT * FROM ducklake.s.vdrop
----
does not exist

# Name conflict: target already has the created table name.
statement ok
CALL ducklake.create_branch('conflict_dev')

statement ok
CALL ducklake.use_branch('conflict_dev')

statement ok
CREATE TABLE ducklake.conflict_name(i INTEGER);

statement ok
CALL ducklake.use_branch('main')

statement ok
CREATE TABLE ducklake.conflict_name(i INTEGER);

# conflict_dev CREATE TABLE is snapshot 22.
query I
SELECT DISTINCT cherry_pick_type
FROM ducklake.cherry_pick('conflict_dev', 22::UBIGINT, target := 'main', dry_run := true)
----
conflicts

statement error
SELECT * FROM ducklake.cherry_pick('conflict_dev', 22::UBIGINT, target := 'main')
----
Cherry-pick conflict

# Transplant CREATE SCHEMA -> CREATE TABLE -> INSERT from a fresh branch.
statement ok
CALL ducklake.create_branch('feature')

statement ok
CALL ducklake.use_branch('feature')

statement ok
CREATE SCHEMA ducklake.tx;

statement ok
CREATE TABLE ducklake.tx.t(n INTEGER);

statement ok
INSERT INTO ducklake.tx.t VALUES (7);

statement ok
CALL ducklake.use_branch('main')

# feature CREATE SCHEMA/TABLE/INSERT are snapshots 24..26.
query II
SELECT DISTINCT transplant_type, snapshots_applied
FROM ducklake.transplant('feature', 24::UBIGINT, 26::UBIGINT, target := 'main')
----
transplant	3

query I
SELECT n FROM ducklake.tx.t
----
7
