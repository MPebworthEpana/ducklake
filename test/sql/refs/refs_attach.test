# name: test/sql/refs/refs_attach.test
# description: Phase 1 ATTACH BRANCH option conflicts
# group: [refs]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_refs_attach')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (42);

statement ok
CALL ducklake_create_branch('ducklake', 'dev')

query I
SELECT ref_name FROM ducklake.refs() WHERE ref_name = 'dev'
----
dev

# BRANCH is mutually exclusive with SNAPSHOT_VERSION / SNAPSHOT_TIME
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake_bad (DATA_PATH '{DATA_PATH}/ducklake_refs_attach', BRANCH 'dev', SNAPSHOT_VERSION 1, OVERRIDE_DATA_PATH TRUE)
----
Cannot specify both

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake_bad (DATA_PATH '{DATA_PATH}/ducklake_refs_attach', BRANCH 'dev', SNAPSHOT_TIME '2020-01-01', OVERRIDE_DATA_PATH TRUE)
----
Cannot specify both
