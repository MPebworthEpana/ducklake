# name: test/sql/refs/refs_at_clause.test
# description: Phase 1 AT (BRANCH/TAG => ...) resolution
# group: [refs]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_refs_at')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1);

statement ok
CALL ducklake_create_tag('ducklake', 'before_second', snapshot_version => (SELECT max(snapshot_id) FROM ducklake.snapshots()))

statement ok
INSERT INTO ducklake.t VALUES (2);

statement ok
CALL ducklake_create_branch('ducklake', 'dev')

query I
SELECT * FROM ducklake.t AT (TAG => 'before_second') ORDER BY i
----
1

query I
SELECT count(*) FROM ducklake.t AT (BRANCH => 'dev')
----
2

statement error
SELECT * FROM ducklake.t AT (BRANCH => 'nope')
----
No snapshot found
